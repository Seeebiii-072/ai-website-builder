+'use client';
+
+import { useCallback, useEffect, useRef, useState } from 'react';
+import { useParams } from 'next/navigation';
+import { api, ProjectResponse } from '@/lib/api';
+import TopBar from '@/components/TopBar';
+import ChatPanel, { ChatMessage } from '@/components/ChatPanel';
+import PreviewPanel from '@/components/PreviewPanel';
+import FileExplorer from '@/components/FileExplorer';
+
+const EVENT_TYPES = [
+  'generation_started', 'generation_completed', 'generation_failed',
+  'build_started', 'build_completed', 'build_failed',
+  'ai_fix_started', 'ai_fix_completed', 'ai_fix_failed',
+  'ai_edit_started', 'ai_edit_completed', 'ai_edit_failed',
+  'preview_starting', 'preview_ready', 'preview_failed', 'preview_stopped',
+];
+
+function describe(type: string, data: any): { text: string; isError?: boolean } | null {
+  switch (type) {
+    case 'generation_started': return { text: 'Generating your website with AI…' };
+    case 'generation_completed': return { text: `Generated ${data?.files_written?.length ?? ''} files (${data?.provider ?? 'AI'}).` };
+    case 'generation_failed': return { text: data?.error || 'Generation failed.', isError: true };
+    case 'build_started': return { text: 'Installing dependencies and building…' };
+    case 'build_completed': return { text: 'Build succeeded.' };
+    case 'build_failed': return { text: `Build failed${data?.attempt ? ` (attempt ${data.attempt})` : ''}.\n${(data?.log || '').slice(-600)}`, isError: true };
+    case 'ai_fix_started': return { text: `AI is fixing the build error (attempt ${data?.attempt})…` };
+    case 'ai_fix_completed': return { text: 'AI applied a fix. Rebuilding…' };
+    case 'ai_fix_failed': return { text: data?.error || 'AI fix failed.', isError: true };
+    case 'ai_edit_started': return { text: 'Applying your change…' };
+    case 'ai_edit_completed': return { text: 'Change applied. Rebuilding…' };
+    case 'ai_edit_failed': return { text: data?.error || 'Edit failed.', isError: true };
+    case 'preview_starting': return { text: 'Starting live preview…' };
+    case 'preview_ready': return { text: 'Live preview is ready.' };
+    case 'preview_failed': return { text: data?.error || 'Preview failed.', isError: true };
+    default: return null;
+  }
+}
+
+export default function ProjectPage() {
+  const params = useParams<{ id: string }>();
+  const id = params.id;
+  const [project, setProject] = useState<ProjectResponse | null>(null);
+  const [messages, setMessages] = useState<ChatMessage[]>([]);
+  const [refreshKey, setRefreshKey] = useState(0);
+  const [busy, setBusy] = useState(false);
+  const seq = useRef(0);
+
+  const push = useCallback((role: ChatMessage['role'], text: string, isError?: boolean) => {
+    seq.current += 1;
+    setMessages((m) => [...m, { id: `${Date.now()}-${seq.current}`, role, text, isError }]);
+  }, []);
+
+  const refreshProject = useCallback(async () => {
+    try {
+      const p = await api.getProject(id);
+      setProject(p);
+      return p;
+    } catch (e: any) {
+      push('system', `Could not load project: ${e.message}`, true);
+      return null;
+    }
+  }, [id, push]);
+
+  // Live events (SSE). Backend replays history on connect.
+  useEffect(() => {
+    refreshProject();
+    const es = new EventSource(api.eventsUrl(id));
+    const handler = (ev: MessageEvent) => {
+      try {
+        const payload = JSON.parse(ev.data);
+        const d = describe(payload.type, payload.data);
+        if (d) push('ai', d.text, d.isError);
+        if (payload.type === 'generation_completed' || payload.type === 'ai_edit_completed' || payload.type === 'ai_fix_completed') {
+          setRefreshKey((k) => k + 1);
+        }
+        refreshProject();
+      } catch {
+        /* ignore malformed event */
+      }
+    };
+    EVENT_TYPES.forEach((t) => es.addEventListener(t, handler));
+    return () => es.close();
+  }, [id, push, refreshProject]);
+
+  // Poll as a safety net while the pipeline is running (SSE can drop on proxies).
+  useEffect(() => {
+    if (!project || !['CREATING', 'GENERATING', 'BUILDING'].includes(project.status)) return;
+    const t = setInterval(refreshProject, 4000);
+    return () => clearInterval(t);
+  }, [project, refreshProject]);
+
+  async function handleSend(text: string) {
+    push('user', text);
+    setBusy(true);
+    try {
+      await api.edit(id, text);
+    } catch (e: any) {
+      push('system', e.message || 'Edit failed', true);
+    } finally {
+      setBusy(false);
+    }
+  }
+
+  async function handleRefresh() {
+    try {
+      if (project?.status === 'READY') await api.restartPreview(id);
+    } catch {
+      /* surfaced via events */
+    }
+    refreshProject();
+  }
+
+  const status = project?.status ?? 'CREATING';
+  const working = ['CREATING', 'GENERATING', 'BUILDING'].includes(status);
+
+  return (
+    <div className="h-screen flex flex-col">
+      <TopBar name={project?.name ?? 'Loading…'} status={status} projectId={id} />
+      <div className="flex-1 grid min-h-0" style={{ gridTemplateColumns: '320px 1fr 280px' }}>
+        <ChatPanel messages={messages} onSend={handleSend} disabled={busy || working} />
+        <PreviewPanel previewUrl={project?.preview_url ?? null} status={status} onRefresh={handleRefresh} />
+        <FileExplorer projectId={id} refreshKey={refreshKey} />
+      </div>
+    </div>
+  );
+}
