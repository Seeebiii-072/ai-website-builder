OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-oss-20b
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# Which provider to try first for every generation/edit/auto-fix call.
# "gemini" (default) or "openrouter". The other one is used automatically
# as the fallback, including when the primary returns invalid/truncated JSON.
LLM_PRIMARY_PROVIDER=gemini

MODEL_TIMEOUT_SECONDS=60
MODEL_MAX_OUTPUT_TOKENS=16000
MODEL_TEMPERATURE=0.2

FRONTEND_URL=http://localhost:3000

PREVIEW_START_PORT=3001
PREVIEW_MAX_PORT=3100

# Local dev: leave both as 127.0.0.1 (default).
# Real server (VPS/etc): PREVIEW_BIND_HOST=0.0.0.0, and
# PREVIEW_PUBLIC_HOST=<server's public IP or domain>, plus open
# PREVIEW_START_PORT-PREVIEW_MAX_PORT in the firewall for TCP.
PREVIEW_BIND_HOST=127.0.0.1
PREVIEW_PUBLIC_HOST=127.0.0.1

MAX_DEBUG_ATTEMPTS=3

DATABASE_URL=sqlite:///./data/app.db
PROJECTS_DIR=./data/projects
